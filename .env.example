# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (safe for the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: the "secret" key (sb_secret_…) or legacy service_role key.
# Used only to send invitations. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase CLI only (applying migrations). Not used by the app.
# Account → Access Tokens, and the database password of the project.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
